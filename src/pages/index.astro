---
import '../styles/global.css';
---
<!doctype html>
<html lang="zh-CN" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>新锐AI生图助手 - AI 智能对话与图片生成</title>
  <meta name="description" content="新锐AI生图助手是一款免费的在线 AI 工具，支持智能对话问答与 AI 图片生成、图生图编辑。无需安装，浏览器直接使用 GPT 系列模型，快速生成文案、解答问题、创作图片。" />
  <meta name="keywords" content="AI生图,AI绘图,AI图片生成,图生图,AI对话,智能助手,在线AI工具,新锐AI生图助手" />
  <meta name="author" content="新锐AI生图助手" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#10a37f" />
  <link rel="canonical" href="https://chat.xrbk.cn/" />
  <link rel="icon" href="/favicon.png" />
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="新锐AI生图助手" />
  <meta property="og:title" content="新锐AI生图助手 - AI 智能对话与图片生成" />
  <meta property="og:description" content="免费的在线 AI 工具，支持智能对话问答与 AI 图片生成、图生图编辑，浏览器直接使用。" />
  <meta property="og:url" content="https://chat.xrbk.cn/" />
  <meta property="og:image" content="https://chat.xrbk.cn/favicon.png" />
  <meta property="og:locale" content="zh_CN" />
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="新锐AI生图助手 - AI 智能对话与图片生成" />
  <meta name="twitter:description" content="免费的在线 AI 工具，支持智能对话问答与 AI 图片生成、图生图编辑。" />
  <meta name="twitter:image" content="https://chat.xrbk.cn/favicon.png" />
  <link rel="sitemap" href="https://chat.xrbk.cn/sitemap.xml" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "新锐AI生图助手",
    "url": "https://chat.xrbk.cn/",
    "description": "免费的在线 AI 工具，支持智能对话问答与 AI 图片生成、图生图编辑。",
    "inLanguage": "zh-CN"
  }
  </script>
  <script is:inline>
    // 首屏加载前恢复主题，避免闪烁
    try {
      var t = localStorage.getItem('gpt_clone_theme') || 'light';
      document.documentElement.setAttribute('data-theme', t);
    } catch (e) {}
  </script>
</head>
<body>
  <div class="layout">
    <!-- 左侧边栏 -->
    <aside class="sidebar">
      <div class="brand">
        <img class="brand-logo" src="/favicon.png" alt="新锐AI生图助手" />
        <span class="brand-name">新锐AI生图助手</span>
      </div>
      <button class="new-chat-btn" id="new-chat-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        <span>新对话</span>
      </button>
      <div class="conv-list" id="conv-list"></div>
    </aside>
    <div class="sidebar-overlay" id="sidebar-overlay"></div>

    <!-- 主区域 -->
    <main class="main">
      <header class="topbar">
        <button class="icon-btn menu-btn" id="menu-btn" title="菜单">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
        <div class="topbar-title" id="topbar-title">新对话</div>
        <div class="topbar-actions">
          <button class="icon-btn" id="theme-toggle" title="切换日夜主题">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          </button>
          <button class="icon-btn" id="settings-btn" title="设置">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          </button>
        </div>
      </header>

      <div class="chat-area" id="chat-area">
        <div class="empty-state" id="empty-state">
          <h1>新锐AI生图助手</h1>
          <p>开始新的对话，或切换到「生图」模式生成图片</p>
        </div>
        <div class="messages" id="messages"></div>
      </div>

      <div class="composer">
        <div class="composer-inner">
          <div class="mode-switch" id="mode-switch">
            <button data-mode="chat" class="active">对话</button>
            <button data-mode="image">生图</button>
          </div>
          <div class="composer-box">
            <div class="image-preview" id="image-preview" hidden>
              <img id="preview-img" alt="上传图片预览" />
              <button class="preview-remove" id="preview-remove" title="移除图片">✕</button>
            </div>
            <textarea id="input" rows="1" placeholder="给 AI 发送消息..."></textarea>
            <button class="upload-btn" id="upload-btn" title="上传图片" hidden>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            </button>
            <button class="send-btn" id="send-btn" title="发送">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5m-7 7 7-7 7 7"/></svg>
            </button>
            <input type="file" id="upload-input" accept="image/*" hidden />
          </div>
          <p class="hint">内容由 AI 生成，请注意甄别</p>
        </div>
      </div>
    </main>
  </div>

  <!-- 设置弹窗 -->
  <div class="modal-overlay" id="settings-modal" hidden>
    <div class="modal">
      <div class="modal-header">
        <h2>设置</h2>
        <button class="icon-btn" id="close-settings" title="关闭">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="modal-body">
        <div class="settings-section">
          <h3>对话配置</h3>
          <label class="field">API 地址
            <input id="chat-url" placeholder="例如 https://api.openai.com/v1" autocomplete="off" />
          </label>
          <label class="field">API Key
            <input id="chat-key" type="password" placeholder="sk-..." autocomplete="off" />
          </label>
          <label class="field">模型
            <input id="chat-model" placeholder="gpt-5.5" autocomplete="off" />
          </label>
        </div>
        <div class="settings-section">
          <h3>生图配置</h3>
          <label class="field">API 地址
            <input id="image-url" placeholder="例如 https://api.openai.com/v1" autocomplete="off" />
          </label>
          <label class="field">API Key
            <input id="image-key" type="password" placeholder="sk-..." autocomplete="off" />
          </label>
          <label class="field">模型
            <input id="image-model" placeholder="gpt-image-2" autocomplete="off" />
          </label>
        </div>
      </div>
      <div class="modal-footer">
        <button class="danger-btn" id="clear-data-btn">清除浏览器中保存的信息</button>
        <button class="primary-btn" id="save-settings">保存</button>
      </div>
    </div>
  </div>

  <div id="toast"></div>

  <script>
    import '../scripts/chat-app.js';
  </script>
</body>
</html>
